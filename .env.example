# JobRadar runs fully without any of these — the matching features simply stay off.
# Copy to .env (gitignored) and fill in what you use.

# The only key JobRadar ever asks for. Optional.
# Keys starting with "sk-ant-" are treated as Anthropic; anything else as OpenAI-compatible.
# API_KEY=

# Optional overrides for OpenAI-compatible providers (OpenRouter, Groq, Ollama, ...)
# LLM_PROVIDER=
# LLM_MODEL=
# LLM_BASE_URL=